# Configurações do Banco de Dados (PostgreSQL local via Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evidence_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# LLM para Imputação (DeepSeek)
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Modelo de Embeddings (OpenAI - 1536 dimensões)
EMBEDDING_API_KEY=sua_chave_openai_aqui
EMBEDDING_MODEL=text-embedding-3-small